        "schema": "embodiment_graph/v2",
        "graph_id": "sensor_only_dual_view_observation",
        "name": "G1 RealSense + External USB Camera Sensor-only Dual-view Observation",
        "intent": "Describe the workspace using both G1 ego RealSense view and an external USB third-person view, without moving any robot.",
        "safety_level": "sensor_only",
        "roles": [
          {
            "role_id": "robot_local_view",
            "description": "Ego/first-person view from a robot-mounted RealSense color stream.",
            "required_capabilities": [
              "observe"
            ],
            "preferred_nodes": [
              "g1_realsense_color_sensor"
            ],
            "minimum": 1,
            "maximum": 1
          },
          {
            "role_id": "external_view",
            "description": "Third-person view from an external USB camera fixed in the workspace.",
            "required_capabilities": [
              "observe"
            ],
            "preferred_nodes": [
              "usb_camera_real"
            ],
            "minimum": 1,
            "maximum": 1
          },
          {
            "role_id": "perception_model",
            "description": "VLM/perception model that fuses the two views into a scene description.",
            "required_capabilities": [
              "image_understanding"
            ],
            "minimum": 1,
            "maximum": 1
          }
        ],
        "nodes": [
          {
            "id": "g1_realsense_color_sensor",
            "role": "robot_local_view",
            "node_type": "sensor",
            "required_capabilities": [
              "observe"
            ]
          },
          {
            "id": "usb_camera_real",
            "role": "external_view",
            "node_type": "sensor",
            "required_capabilities": [
              "observe"
            ]
          },
          {
            "id": "perception_vision",
            "role": "perception_model",
            "node_type": "perception_model",
            "required_capabilities": [
              "image_understanding"
            ]
          }
        ],
        "edges": [
          {
            "source": "g1_realsense_color_sensor",
            "target": "perception_vision",
            "edge_type": "observation_stream"
          },
          {
            "source": "usb_camera_real",
            "target": "perception_vision",
            "edge_type": "observation_stream"
          }
        ],
        "constraints": {
          "allow_motion": false,
          "allow_manipulation": false,
          "allow_audio_output": false,
          "forbidden_actions": [
            "navigate",
            "walk",
            "move",
            "turn",
            "grasp",
            "pick",
            "place",
            "carry",
            "hand_over",
            "open_door",
            "whole_body_motion",
            "arm_motion",
            "hand_motion",
            "audio_output"
          ]
        },
        "readiness_checks": [
          "all_required_nodes_exist",
          "required_capabilities_are_safe",
          "sensor_artifacts_available_or_capture_allowed",
          "no_forbidden_action_in_task"
        ],
        "failure_modes": [
          {
            "id": "node_missing",
            "when": "g1_realsense_color_sensor or usb_camera_real not in topology",
            "attribution": "topology"
          },
          {
            "id": "node_offline",
            "when": "capture probe fails for either sensor",
            "attribution": "hardware"
          },
          {
            "id": "forbidden_action_requested",
            "when": "task asks for any locomotion/manipulation/audio_output",
            "attribution": "planner"
          },
          {
            "id": "sensor_artifact_missing",
            "when": "at least one expected frame file is not produced",
            "attribution": "sensor"
          }
        ],
        "recovery": {
          "auto_allowed": [
            "retry_passive_health_check",
            "downgrade_multiview_to_single_view"
          ],
          "requires_confirmation": [
            "any_motion",
            "any_manipulation",
            "audio_output"
          ],
          "not_recoverable": [
            "missing_capable_executor"
          ]
        },
        "outputs": [
          "dual_view_scene_description",
          "sensor_readiness_report",
          "failure_attribution",
          "episode_trace"
        ]
      }
    ],
